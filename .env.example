# Demo examples are seeded in the local workspace; they are not real company records.
DEMO_MODE=true
# Leave blank to use .data locally and Vercel's writable /tmp directory online.
BRAHMA_DATA_DIR=
# Enable only behind HTTPS if using production start locally.
SECURE_COOKIES=false

# Add your Gemini API key in .env.local (never commit it).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Supabase Vercel Marketplace connection (server-only; never add NEXT_PUBLIC_)
POSTGRES_URL=
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Supabase Auth login uses this key on the server to sign in and refresh users.
SUPABASE_PUBLISHABLE_KEY=
# Generate a unique random value of at least 32 characters for first-admin setup.
BRAHMA_FIRST_ADMIN_SETUP_TOKEN=
# Generate 32 random bytes and base64 encode them; used to encrypt Auth tokens at rest.
BRAHMA_SESSION_ENCRYPTION_KEY=
